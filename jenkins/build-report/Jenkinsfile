pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run HTTP checks'
        )

        string(
            name: 'SOURCE_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to test'
        )
    }

    environment{
        CHECK_URL = "https://example.com"
    }
    
    stages {
        stage("Check environment"){
            when {
                expression { params.RUN_TESTS }
            }
            steps {
                sh 'curl --fail -I --max-time 10 "$CHECK_URL"'
            }
        }

        stage('Checkout selected branch'){
            steps {
                dir('source') {
                    git branch: params.SOURCE_BRANCH,
                        url: 'https://github.com/leanovichilya/devops-infra-lab.git'

                    sh 'git rev-parse --short HEAD'
                    sh '''
                        if [ -f jenkins/build-report/branch-marker.txt ]; then
                            cat jenkins/build-report/branch-marker.txt
                        else
                            echo "Branch marker not found"
                        fi
                    '''
                }
            }
        }

        stage ("Generate") {
            steps {
                sh 'echo "Build number: $BUILD_NUMBER" > build-report.txt'
                sh 'id >> build-report.txt'
                sh 'date >> build-report.txt'
                sh 'echo Pipeline source: GitHub - polling test'
            }
        }
        
        stage ("Validate") {
            steps {
                sh '''
                    if grep -q "Build number:" build-report.txt; then
                            echo "Report is valid"
                    else 
                        echo "FAILURE"
                        exit 1
                    fi
                '''
            }
        }
        
        stage ("Archive") {
            steps {
                archiveArtifacts artifacts: 'build-report.txt'
            }
        }
    }
    
}