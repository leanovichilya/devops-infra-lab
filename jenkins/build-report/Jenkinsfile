pipeline {
    agent {
        label 'docker-agent'
    }

    parameters {
        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run HTTP checks'
        )

        string(
            name: 'SOURCE_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to test'
        )
    }

    environment{
        CHECK_URL = 'https://example.com'
    }
    
    stages {
        stage("Prepare workspace"){
            steps {
                sh 'hostname'
                sh 'id'
                sh 'pwd'
                sh 'rm -f build-report.txt'
            }
        }

        stage('Credentials check') {
            steps {
                withCredentials([
                    string(credentialsId: 'registry-token',
                           variable: 'REGISTRY_TOKEN')
                ]) {
                    sh '''
                        set +x
                        test -n "$REGISTRY_TOKEN"
                        echo "Registry token is available"
                    '''
                }

                sh 'test -z "$REGISTRY_TOKEN"'
                echo 'Token is unavailable outside credentials block'
            }
        }

        stage('Checkout selected branch'){
            steps {
                dir('source') {
                    git branch: params.SOURCE_BRANCH,
                        url: 'https://github.com/leanovichilya/devops-infra-lab.git'

                    sh 'git rev-parse --short HEAD'
                    sh '''
                        if [ -f jenkins/build-report/branch-marker.txt ]; then
                            cat jenkins/build-report/branch-marker.txt
                        else
                            echo "Branch marker not found"
                        fi
                    '''
                }
            }
        }

        stage('Parallel checks') {
            failFast true

            parallel {
                stage('HTTP health'){
                    when {
                        expression { params.RUN_TESTS }
                    }
                    
                    steps {
                        retry(3){
                            sh 'curl --fail -I --max-time 10 "$CHECK_URL"'
                        }
                    }
                }

                stage('Source files') {
                    steps {
                        dir('source') {
                            sh 'test -f jenkins/build-report/Jenkinsfile'
                            echo 'Source file exists'
                        }
                    }
                }
            }
        }

        stage ("Generate") {
            steps {
                sh 'echo "Build number: $BUILD_NUMBER" > build-report.txt'
                sh 'id >> build-report.txt'
                sh 'date >> build-report.txt'
                sh 'echo Pipeline source: GitHub - polling test'
            }
        }
        
        stage ("Validate") {
            steps {
                sh '''
                    if grep -q "Build number:" build-report.txt; then
                            echo "Report is valid"
                    else 
                        echo "FAILURE"
                        exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'build-report.txt',
                            allowEmptyArchive: true
        }
    }
}